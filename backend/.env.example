# ResQGrid Backend Configuration Template (SIH26191)
# Copy this file to .env and adjust values for your environment.

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Security & CORS
# Comma-separated list of allowed origins. Use '*' for open development or specify origins for production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://resqgrid.gov.in

# Database Configuration (PostGIS / SQLite Spatial Fallback)
# Development fallback: sqlite:///./resqgrid.db
# Production PostGIS: postgresql+psycopg2://postgres:password@localhost:5432/resqgrid_spatial
DATABASE_URL=sqlite:///./resqgrid.db

# MILP Solver Backend Preference (pulp / ortools / greedy)
SOLVER_BACKEND=pulp

# GenAI & LLM Services (Phase 5/6 Integration)
# GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Security, RBAC & Governance (Phase 7 Integration)
RBAC_ENABLED=true
RATE_LIMIT_STANDARD_PER_MIN=120
RATE_LIMIT_HEAVY_PER_MIN=30
