# ResQGrid Frontend Configuration Template (SIH26191)
# Copy this file to .env.local for local development.

# Backend API Endpoint
# Local Development: http://localhost:8000
# Production Cloud: https://sih-disaster-management-botb.onrender.com
VITE_API_URL=http://localhost:8000

# Geographic Default View (Wayanad / Kerala Disaster Region)
VITE_MAP_DEFAULT_LAT=11.5833
VITE_MAP_DEFAULT_LNG=76.1333
VITE_MAP_DEFAULT_ZOOM=12

# Application Branding
VITE_APP_TITLE=ResQGrid NDRF Decision Support Platform
